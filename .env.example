# Example: http://127.0.0.1:33318
RPC_URL=
RPC_USER=
RPC_PASS=

# Supported: b1tcore, bells, doge
BLOCKCHAIN=b1tcore
# [Optional] Path to the folder with blk[xxx].dat files (example: /root/.bit/blocks)
BLK_DIR=
# [Optional] Path to the folder with LevelDB of node, must be copied using rsync to another folder (example: /root/.bit/blocks/index copied to ./index)
INDEX_DIR=

# [Optional] (default: mainnet) (mainnet, testnet)
NETWORK=mainnet

# [Optional] (default: 0.0.0.0:8080)
SERVER_BIND_URL=0.0.0.0:8080
